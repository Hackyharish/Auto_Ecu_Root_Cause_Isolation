    <ECU-VARIANTS>
      <ECU-VARIANT ID="ECU_ABS">
        <SHORT-NAME>ABS_ESP_ECU</SHORT-NAME>
        <LONG-NAME>Anti-Lock Braking System / Electronic Stability Program</LONG-NAME>
        <DESC><p>Chassis control module responsible for wheel speed sensing and ABS/ESP intervention.</p></DESC>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DTC_DOP_ECU_ABS">
              <SHORT-NAME>DTC_DOP_ECU_ABS</SHORT-NAME>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE"><BIT-LENGTH>24</BIT-LENGTH></DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
              <COMPU-METHOD><CATEGORY>IDENTICAL</CATEGORY></COMPU-METHOD>
              <DTCS>
                <DTC ID="DTC_ABS_C003513">
                  <SHORT-NAME>C0035_13</SHORT-NAME>
                  <TROUBLE-CODE>12583761</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>C0035-13</DISPLAY-TROUBLE-CODE>
                  <TEXT>Left Front Wheel Speed Sensor Circuit Open</TEXT>
                </DTC>
                <DTC ID="DTC_ABS_U012100">
                  <SHORT-NAME>U0121_00</SHORT-NAME>
                  <TROUBLE-CODE>13705472</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0121-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Lost Communication with ABS Control Module</TEXT>
                </DTC>
              </DTCS>
            </DTC-DOP>
          </DTC-DOPS>
          <STRUCTURES>
            <STRUCTURE ID="STRUCT_DTC_Rec_ECU_ABS" BYTE-SIZE="4">
              <SHORT-NAME>DTCAndStatusRecord_ABS_ESP_ECU</SHORT-NAME>
              <PARAMS>
