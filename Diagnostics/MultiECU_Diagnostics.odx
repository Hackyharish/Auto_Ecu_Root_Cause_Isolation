              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
            </DATA-OBJECT-PROP>
            <DATA-OBJECT-PROP ID="DOP_ABS_ESP_ECU_DID_0201">
              <SHORT-NAME>DOP_VehicleSpeed</SHORT-NAME>
              <COMPU-METHOD><CATEGORY>IDENTICAL</CATEGORY></COMPU-METHOD>
