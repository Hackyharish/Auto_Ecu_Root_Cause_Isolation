                  <SHORT-NAME>DTCRecord</SHORT-NAME>
                  <BYTE-POSITION>0</BYTE-POSITION>
                  <DOP-REF ID-REF="DTC_DOP_ECU_ABS"/>
                </PARAM>
                <PARAM SEMANTIC="DTCSTATUS" xsi:type="VALUE">
