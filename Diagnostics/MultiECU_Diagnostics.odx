<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================================
     ASAM MCD-2D (ODX 2.2.0) Diagnostic Description File
     Project: Automated Root Cause Isolation in Multi-ECU In-Vehicle Networks
     Specification: ISO 22901-1 (ODX) / ISO 14229-1:2013 (UDS) / ISO 15765-2 (DoCAN)
     Author: IVN Capstone Team | Tata Technologies TechPulse
     ========================================================================= -->
<ODX MODEL-VERSION="2.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="odx.xsd">
  <DIAG-LAYER-CONTAINER ID="DLC_MultiECU_Diagnostics">
    <SHORT-NAME>MultiECU_Diagnostics_Container</SHORT-NAME>
    <LONG-NAME>In-Vehicle Multi-ECU Diagnostic Description</LONG-NAME>
    <DESC>
      <p>ASAM MCD-2D ODX description for ECM, TCM, ABS, and BCM diagnostic services.</p>
    </DESC>

    <BASE-VARIANTS>
      <BASE-VARIANT ID="BV_UDS_Base">
        <SHORT-NAME>UDS_Base_Protocol</SHORT-NAME>
        <LONG-NAME>ISO 14229-1:2013 Unified Diagnostic Services on CAN</LONG-NAME>
        <DESC>
          <p>Common UDS diagnostic protocol base specification according to ISO 14229-1:2013.</p>
        </DESC>

        <DIAG-DATA-DICTIONARY-SPEC>
          <DATA-OBJECT-PROPS>
            <DATA-OBJECT-PROP ID="DOP_VehicleSpeed">
              <SHORT-NAME>DOP_VehicleSpeed</SHORT-NAME>
              <COMPU-METHOD>
                <CATEGORY>LINEAR</CATEGORY>
                <COMPU-INTERNAL-TO-PHYS>
                  <COMPU-SCALES>
                    <COMPU-SCALE>
                      <COMPU-RATIONAL-COEFFS>
                        <COMPU-NUMERATOR>
                          <V>0</V>
                          <V>0.01</V>
                        </COMPU-NUMERATOR>
                        <COMPU-DENOMINATOR>
                          <V>1</V>
                        </COMPU-DENOMINATOR>
                      </COMPU-RATIONAL-COEFFS>
                    </COMPU-SCALE>
                  </COMPU-SCALES>
                </COMPU-INTERNAL-TO-PHYS>
              </COMPU-METHOD>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>16</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_FLOAT64"/>
              <UNIT-REF ID-REF="UNIT_km_h"/>
            </DATA-OBJECT-PROP>

            <DATA-OBJECT-PROP ID="DOP_EngineSpeed">
              <SHORT-NAME>DOP_EngineSpeed</SHORT-NAME>
              <COMPU-METHOD>
                <CATEGORY>LINEAR</CATEGORY>
                <COMPU-INTERNAL-TO-PHYS>
                  <COMPU-SCALES>
                    <COMPU-SCALE>
                      <COMPU-RATIONAL-COEFFS>
                        <COMPU-NUMERATOR>
                          <V>0</V>
                          <V>0.25</V>
                        </COMPU-NUMERATOR>
                        <COMPU-DENOMINATOR>
                          <V>1</V>
                        </COMPU-DENOMINATOR>
                      </COMPU-RATIONAL-COEFFS>
                    </COMPU-SCALE>
                  </COMPU-SCALES>
                </COMPU-INTERNAL-TO-PHYS>
              </COMPU-METHOD>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>16</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_FLOAT64"/>
              <UNIT-REF ID-REF="UNIT_rpm"/>
            </DATA-OBJECT-PROP>

            <DATA-OBJECT-PROP ID="DOP_CoolantTemp">
              <SHORT-NAME>DOP_CoolantTemp</SHORT-NAME>
              <COMPU-METHOD>
                <CATEGORY>LINEAR</CATEGORY>
                <COMPU-INTERNAL-TO-PHYS>
                  <COMPU-SCALES>
                    <COMPU-SCALE>
                      <COMPU-RATIONAL-COEFFS>
                        <COMPU-NUMERATOR>
                          <V>-40</V>
                          <V>1.0</V>
                        </COMPU-NUMERATOR>
                        <COMPU-DENOMINATOR>
                          <V>1</V>
                        </COMPU-DENOMINATOR>
                      </COMPU-RATIONAL-COEFFS>
                    </COMPU-SCALE>
                  </COMPU-SCALES>
                </COMPU-INTERNAL-TO-PHYS>
              </COMPU-METHOD>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>8</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_FLOAT64"/>
              <UNIT-REF ID-REF="UNIT_degC"/>
            </DATA-OBJECT-PROP>
          </DATA-OBJECT-PROPS>

          <UNIT-SPEC>
            <UNITS>
              <UNIT ID="UNIT_km_h">
                <SHORT-NAME>km_h</SHORT-NAME>
                <DISPLAY-NAME>km/h</DISPLAY-NAME>
                <FACTOR-SI-TO-UNIT>1</FACTOR-SI-TO-UNIT>
                <OFFSET-SI-TO-UNIT>0</OFFSET-SI-TO-UNIT>
              </UNIT>
              <UNIT ID="UNIT_rpm">
                <SHORT-NAME>rpm</SHORT-NAME>
                <DISPLAY-NAME>rpm</DISPLAY-NAME>
                <FACTOR-SI-TO-UNIT>1</FACTOR-SI-TO-UNIT>
                <OFFSET-SI-TO-UNIT>0</OFFSET-SI-TO-UNIT>
              </UNIT>
              <UNIT ID="UNIT_degC">
                <SHORT-NAME>degC</SHORT-NAME>
                <DISPLAY-NAME>degC</DISPLAY-NAME>
                <FACTOR-SI-TO-UNIT>1</FACTOR-SI-TO-UNIT>
                <OFFSET-SI-TO-UNIT>0</OFFSET-SI-TO-UNIT>
              </UNIT>
              <UNIT ID="UNIT_bar">
                <SHORT-NAME>bar</SHORT-NAME>
                <DISPLAY-NAME>bar</DISPLAY-NAME>
                <FACTOR-SI-TO-UNIT>1</FACTOR-SI-TO-UNIT>
                <OFFSET-SI-TO-UNIT>0</OFFSET-SI-TO-UNIT>
              </UNIT>
              <UNIT ID="UNIT_V">
                <SHORT-NAME>Volt</SHORT-NAME>
                <DISPLAY-NAME>V</DISPLAY-NAME>
                <FACTOR-SI-TO-UNIT>1</FACTOR-SI-TO-UNIT>
                <OFFSET-SI-TO-UNIT>0</OFFSET-SI-TO-UNIT>
              </UNIT>
            </UNITS>
          </UNIT-SPEC>
        </DIAG-DATA-DICTIONARY-SPEC>

        <DIAG-COMMS>
          <!-- 0x10: DiagnosticSessionControl -->
          <DIAG-SERVICE ID="DS_DiagnosticSessionControl" SEMANTIC="SESSION">
            <SHORT-NAME>DiagnosticSessionControl</SHORT-NAME>
            <LONG-NAME>UDS Service 0x10 - Diagnostic Session Control</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_DiagnosticSessionControl"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_DiagnosticSessionControl"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>

          <!-- 0x11: ECUReset -->
          <DIAG-SERVICE ID="DS_ECUReset" SEMANTIC="RESET">
            <SHORT-NAME>ECUReset</SHORT-NAME>
            <LONG-NAME>UDS Service 0x11 - ECU Reset</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_ECUReset"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_ECUReset"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>

          <!-- 0x14: ClearDiagnosticInformation -->
          <DIAG-SERVICE ID="DS_ClearDiagnosticInformation" SEMANTIC="FAULTMEMORY">
            <SHORT-NAME>ClearDiagnosticInformation</SHORT-NAME>
            <LONG-NAME>UDS Service 0x14 - Clear Diagnostic Information</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_ClearDiagnosticInformation"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_ClearDiagnosticInformation"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>

          <!-- 0x19: ReadDTCInformation -->
          <DIAG-SERVICE ID="DS_ReadDTCInformation" SEMANTIC="FAULTMEMORY">
            <SHORT-NAME>ReadDTCInformation</SHORT-NAME>
            <LONG-NAME>UDS Service 0x19 - Read DTC Information</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_ReadDTCInformation"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_ReadDTCInformation"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>

          <!-- 0x22: ReadDataByIdentifier -->
          <DIAG-SERVICE ID="DS_ReadDataByIdentifier" SEMANTIC="DATA">
            <SHORT-NAME>ReadDataByIdentifier</SHORT-NAME>
            <LONG-NAME>UDS Service 0x22 - Read Data By Identifier</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_ReadDataByIdentifier"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_ReadDataByIdentifier"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>

          <!-- 0x3E: TesterPresent -->
          <DIAG-SERVICE ID="DS_TesterPresent" SEMANTIC="TESTERPRESENT">
            <SHORT-NAME>TesterPresent</SHORT-NAME>
            <LONG-NAME>UDS Service 0x3E - Tester Present</LONG-NAME>
            <REQUEST-REF ID-REF="REQ_TesterPresent"/>
            <POS-RESPONSE-REFS>
              <POS-RESPONSE-REF ID-REF="POS_TesterPresent"/>
            </POS-RESPONSE-REFS>
          </DIAG-SERVICE>
        </DIAG-COMMS>

        <REQUESTS>
          <!-- Request 0x10 -->
          <REQUEST ID="REQ_DiagnosticSessionControl">
            <SHORT-NAME>REQ_DiagnosticSessionControl</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>16</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>

          <!-- Request 0x11 -->
          <REQUEST ID="REQ_ECUReset">
            <SHORT-NAME>REQ_ECUReset</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>17</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>

          <!-- Request 0x14 -->
          <REQUEST ID="REQ_ClearDiagnosticInformation">
            <SHORT-NAME>REQ_ClearDiagnosticInformation</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>20</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>

          <!-- Request 0x19 -->
          <REQUEST ID="REQ_ReadDTCInformation">
            <SHORT-NAME>REQ_ReadDTCInformation</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>25</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>

          <!-- Request 0x22 -->
          <REQUEST ID="REQ_ReadDataByIdentifier">
            <SHORT-NAME>REQ_ReadDataByIdentifier</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>34</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>

          <!-- Request 0x3E -->
          <REQUEST ID="REQ_TesterPresent">
            <SHORT-NAME>REQ_TesterPresent</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>SID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>62</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </REQUEST>
        </REQUESTS>

        <POS-RESPONSES>
          <!-- Response 0x50 -->
          <POS-RESPONSE ID="POS_DiagnosticSessionControl">
            <SHORT-NAME>POS_DiagnosticSessionControl</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>80</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>

          <!-- Response 0x51 -->
          <POS-RESPONSE ID="POS_ECUReset">
            <SHORT-NAME>POS_ECUReset</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>81</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>

          <!-- Response 0x54 -->
          <POS-RESPONSE ID="POS_ClearDiagnosticInformation">
            <SHORT-NAME>POS_ClearDiagnosticInformation</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>84</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>

          <!-- Response 0x59 -->
          <POS-RESPONSE ID="POS_ReadDTCInformation">
            <SHORT-NAME>POS_ReadDTCInformation</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>89</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>

          <!-- Response 0x62 -->
          <POS-RESPONSE ID="POS_ReadDataByIdentifier">
            <SHORT-NAME>POS_ReadDataByIdentifier</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>98</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>

          <!-- Response 0x7E -->
          <POS-RESPONSE ID="POS_TesterPresent">
            <SHORT-NAME>POS_TesterPresent</SHORT-NAME>
            <PARAMS>
              <PARAM SEMANTIC="SERVICE-ID" xsi:type="CODED-CONST">
                <SHORT-NAME>RSID</SHORT-NAME>
                <BYTE-POSITION>0</BYTE-POSITION>
                <CODED-VALUE>126</CODED-VALUE>
                <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                  <BIT-LENGTH>8</BIT-LENGTH>
                </DIAG-CODED-TYPE>
              </PARAM>
            </PARAMS>
          </POS-RESPONSE>
        </POS-RESPONSES>
      </BASE-VARIANT>
    </BASE-VARIANTS>

    <ECU-VARIANTS>
      <!-- 1. ABS / ESP ECU Variant -->
      <ECU-VARIANT ID="ECU_ABS">
        <SHORT-NAME>ABS_ESP_ECU</SHORT-NAME>
        <LONG-NAME>Anti-Lock Braking System / Electronic Stability Program</LONG-NAME>
        <DESC>
          <p>Chassis control module responsible for wheel speed sensing and ABS/ESP intervention.</p>
        </DESC>
        <PARENT-REFS>
          <PARENT-REF xsi:type="BASE-VARIANT-REF" ID-REF="BV_UDS_Base"/>
        </PARENT-REFS>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DTC_DOP_ABS">
              <SHORT-NAME>DTC_DOP_ABS</SHORT-NAME>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>24</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DTCS>
                <DTC ID="DTC_C003513">
                  <SHORT-NAME>C0035_13</SHORT-NAME>
                  <TROUBLE-CODE>12583761</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>C0035-13</DISPLAY-TROUBLE-CODE>
                  <TEXT>Left Front Wheel Speed Sensor Circuit Open</TEXT>
                </DTC>
                <DTC ID="DTC_U012100">
                  <SHORT-NAME>U0121_00</SHORT-NAME>
                  <TROUBLE-CODE>13705472</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0121-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Lost Communication with ABS Control Module</TEXT>
                </DTC>
              </DTCS>
            </DTC-DOP>
          </DTC-DOPS>
        </DIAG-DATA-DICTIONARY-SPEC>
      </ECU-VARIANT>

      <!-- 2. ECM ECU Variant -->
      <ECU-VARIANT ID="ECU_ECM">
        <SHORT-NAME>ECM_ECU</SHORT-NAME>
        <LONG-NAME>Engine Control Module / Powertrain Controller</LONG-NAME>
        <DESC>
          <p>Powertrain controller managing engine throttle, ignition, and fuel injection.</p>
        </DESC>
        <PARENT-REFS>
          <PARENT-REF xsi:type="BASE-VARIANT-REF" ID-REF="BV_UDS_Base"/>
        </PARENT-REFS>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DTC_DOP_ECM">
              <SHORT-NAME>DTC_DOP_ECM</SHORT-NAME>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>24</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DTCS>
                <DTC ID="DTC_P012212">
                  <SHORT-NAME>P0122_12</SHORT-NAME>
                  <TROUBLE-CODE>74258</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P0122-12</DISPLAY-TROUBLE-CODE>
                  <TEXT>Throttle Position Sensor 'A' Circuit Low Input</TEXT>
                </DTC>
                <DTC ID="DTC_P021700">
                  <SHORT-NAME>P0217_00</SHORT-NAME>
                  <TROUBLE-CODE>136960</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P0217-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Engine Coolant Over-Temperature Condition</TEXT>
                </DTC>
                <DTC ID="DTC_P050000">
                  <SHORT-NAME>P0500_00</SHORT-NAME>
                  <TROUBLE-CODE>327680</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P0500-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Vehicle Speed Sensor 'A' Missing Signal</TEXT>
                </DTC>
                <DTC ID="DTC_P050400">
                  <SHORT-NAME>P0504_00</SHORT-NAME>
                  <TROUBLE-CODE>328704</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>P0504-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Brake Switch A/B Correlation Plausibility Fault</TEXT>
                </DTC>
                <DTC ID="DTC_U010000">
                  <SHORT-NAME>U0100_00</SHORT-NAME>
                  <TROUBLE-CODE>13697024</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0100-00</DISPLAY-TROUBLE-CODE>
                  <TEXT>Lost Communication with ECM/PCM</TEXT>
                </DTC>
              </DTCS>
            </DTC-DOP>
          </DTC-DOPS>
        </DIAG-DATA-DICTIONARY-SPEC>
      </ECU-VARIANT>

      <!-- 3. TCM ECU Variant -->
      <ECU-VARIANT ID="ECU_TCM">
        <SHORT-NAME>TCM_ECU</SHORT-NAME>
        <LONG-NAME>Transmission Control Module</LONG-NAME>
        <DESC>
          <p>Automatic transmission controller computing shift schedules and gear selections.</p>
        </DESC>
        <PARENT-REFS>
          <PARENT-REF xsi:type="BASE-VARIANT-REF" ID-REF="BV_UDS_Base"/>
        </PARENT-REFS>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DTC_DOP_TCM">
              <SHORT-NAME>DTC_DOP_TCM</SHORT-NAME>
              <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" xsi:type="STANDARD-LENGTH-TYPE">
                <BIT-LENGTH>24</BIT-LENGTH>
              </DIAG-CODED-TYPE>
              <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
              <COMPU-METHOD>
                <CATEGORY>IDENTICAL</CATEGORY>
              </COMPU-METHOD>
              <DTCS>
                <DTC ID="DTC_U041581">
                  <SHORT-NAME>U0415_81</SHORT-NAME>
                  <TROUBLE-CODE>13899137</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0415-81</DISPLAY-TROUBLE-CODE>
                  <TEXT>Invalid Data Received from ABS Module (Secondary Cascade)</TEXT>
                </DTC>
                <DTC ID="DTC_U040186">
                  <SHORT-NAME>U0401_86</SHORT-NAME>
                  <TROUBLE-CODE>13894022</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0401-86</DISPLAY-TROUBLE-CODE>
                  <TEXT>Invalid Data Received from ECM (Throttle Signal)</TEXT>
                </DTC>
                <DTC ID="DTC_U040182">
                  <SHORT-NAME>U0401_82</SHORT-NAME>
                  <TROUBLE-CODE>13894018</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0401-82</DISPLAY-TROUBLE-CODE>
                  <TEXT>Invalid Data Received from ECM (Coolant Range)</TEXT>
                </DTC>
                <DTC ID="DTC_U042281">
                  <SHORT-NAME>U0422_81</SHORT-NAME>
                  <TROUBLE-CODE>13902465</TROUBLE-CODE>
                  <DISPLAY-TROUBLE-CODE>U0422-81</DISPLAY-TROUBLE-CODE>
                  <TEXT>Invalid Data Received from BCM (Brake Switch Conflict)</TEXT>
                </DTC>
              </DTCS>
            </DTC-DOP>
          </DTC-DOPS>
        </DIAG-DATA-DICTIONARY-SPEC>
      </ECU-VARIANT>

      <!-- 4. BCM ECU Variant -->
      <ECU-VARIANT ID="ECU_BCM">
        <SHORT-NAME>BCM_ECU</SHORT-NAME>
        <LONG-NAME>Body Control Module</LONG-NAME>
        <DESC>
          <p>Body electronics controller handling lighting, brake pedals, and gateway signals.</p>
        </DESC>
        <PARENT-REFS>
          <PARENT-REF xsi:type="BASE-VARIANT-REF" ID-REF="BV_UDS_Base"/>
        </PARENT-REFS>
        <DIAG-DATA-DICTIONARY-SPEC>
          <DTC-DOPS>
            <DTC-DOP ID="DTC_DOP_BCM">
