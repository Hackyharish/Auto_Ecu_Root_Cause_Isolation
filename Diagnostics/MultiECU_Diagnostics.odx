              </PARAMS>
            </STRUCTURE>
          </STRUCTURES>
          <END-OF-PDU-FIELDS>
            <END-OF-PDU-FIELD ID="EOP_DTC_ECU_ABS">
              <SHORT-NAME>DTCAndStatusList_ABS_ESP_ECU</SHORT-NAME>
              <MIN-NUMBER-OF-ITEMS>0</MIN-NUMBER-OF-ITEMS>
              <BASIC-STRUCTURE-REF ID-REF="STRUCT_DTC_Rec_ECU_ABS"/>
            </END-OF-PDU-FIELD>
          </END-OF-PDU-FIELDS>
          <DATA-OBJECT-PROPS>
            <DATA-OBJECT-PROP ID="DOP_ABS_ESP_ECU_DID_0200">
